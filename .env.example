# Zarvis configuration
# Copy this file to .env (or ~/.zarvis/.env) and fill in your values

# API endpoint (OpenRouter by default)
BASE_URL=https://openrouter.ai/api/v1

# Your API key
API_KEY=sk-or-...

# Model to use
MODEL=poolside/laguna-s-2.1:free

# Optional: context window size in tokens
# CONTEXT_TOKENS=128000
